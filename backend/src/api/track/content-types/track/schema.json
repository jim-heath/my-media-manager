{
  "kind": "collectionType",
  "collectionName": "tracks",
  "info": {
    "singularName": "track",
    "pluralName": "tracks",
    "displayName": "Track",
    "description": "Album track"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "track_number": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "title": {
      "type": "string",
      "required": true
    },
    "length": {
      "type": "integer",
      "min": 0,
      "description": "Track length in seconds"
    },
    "album": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::album.album",
      "inversedBy": "tracks"
    },
    "mbid": {
      "type": "string",
      "description": "MusicBrainz Recording ID"
    }
  }
}
