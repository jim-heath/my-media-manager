HOST=0.0.0.0
PORT=1337

# Comma-separated list of allowed CORS origins (frontend URLs).
# Defaults to localhost dev servers when unset.
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Generate strong random values for each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# API Keys (optional but recommended)
# Discogs: use EITHER the consumer key/secret from your Discogs "application"...
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# ...OR a personal access token (leave key/secret blank if using this)
DISCOGS_TOKEN=
# iTunes, Deezer, and Cover Art Archive are used as cover-art fallbacks and
# require no credentials.
# Spotify support is planned for a future release:
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# MusicBrainz requires a meaningful, unique User-Agent with a real contact.
# Generic/placeholder values get rate-limited or blocked. Set yours here.
APP_USER_AGENT=MyMediaManager/1.0 (your-real-email@example.com)

# Database
# Development uses SQLite by default. For production set DATABASE_CLIENT=mysql.
DATABASE_CLIENT=sqlite

# --- SQLite (development) ---
DATABASE_FILENAME=.tmp/data.db

# --- MySQL (production) ---
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=media_manager
# DATABASE_USERNAME=media_manager
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000
